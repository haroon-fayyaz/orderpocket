---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="page-header section">
  <div class="container page-header-inner">
    {eyebrow && <p class="section-label">{eyebrow}</p>}
    <h1 class="page-title">{title}</h1>
    {description && <p class="page-desc">{description}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-bottom: 2rem;
    background: linear-gradient(180deg, var(--color-primary-light) 0%, transparent 100%);
  }

  .page-header-inner {
    max-width: 40rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .page-desc {
    font-size: 1.125rem;
    margin: 0;
    max-width: 50ch;
  }
</style>