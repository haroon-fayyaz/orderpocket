---
/** Stylized in-app preview — not a fabricated screenshot. */
---

<div class="phone" role="img" aria-label="Illustration of the OrderPocket home screen with local orders and reminders">
  <div class="phone-bezel">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="screen">
      <div class="screen-bar">
        <span class="screen-title">Orders</span>
        <span class="pill">Offline</span>
      </div>
      <ul class="order-list">
        <li>
          <strong>Chocolate truffle cake</strong>
          <span>Pickup · Sun · Partially paid</span>
        </li>
        <li>
          <strong>Custom cupcakes ×24</strong>
          <span>Delivery · Wed · Confirmed</span>
        </li>
        <li>
          <strong>Eggless red velvet</strong>
          <span>Preparing · Fri · Paid</span>
        </li>
      </ul>
      <p class="screen-note">Paste, share, or type — then you review before anything is saved.</p>
    </div>
  </div>
</div>

<style>
  .phone {
    width: min(300px, 100%);
    margin-inline: auto;
  }

  .phone-bezel {
    background: #1c1b1f;
    border-radius: 2.25rem;
    padding: 0.65rem;
    box-shadow: var(--shadow-lg);
  }

  .phone-notch {
    width: 28%;
    height: 5px;
    margin: 0.35rem auto 0.5rem;
    background: #2d2c30;
    border-radius: 999px;
  }

  .screen {
    background: var(--color-surface);
    border-radius: 1.75rem;
    padding: 1.1rem 1rem 1.25rem;
    min-height: 380px;
  }

  .screen-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .screen-title {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .pill {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .order-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .order-list li {
    padding: 0.85rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }

  .order-list strong {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .order-list span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .screen-note {
    font-size: 0.75rem;
    margin: 0;
    padding: 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-icon-bg);
    color: var(--color-text-muted);
    line-height: 1.45;
  }
</style>